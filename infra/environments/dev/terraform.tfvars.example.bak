# terraform.tfvars - Example configuration for HLS Pipeline
# Copy this file and customize for your environment

# =============================================================================
# Environment
# =============================================================================

environment = "dev"
aws_region  = "us-east-1"

common_tags = {
  Project     = "hls-pipeline"
  ManagedBy   = "terraform"
  Environment = "dev"
  Team        = "video-platform"
}

# =============================================================================
# S3 Buckets
# =============================================================================

raw_bucket_name       = "my-company-hls-raw-dev"
processed_bucket_name = "my-company-hls-processed-dev"

# Optional - if not set, defaults will be derived from processed_bucket_name
# ad_segments_bucket_name = "my-company-hls-ads-dev"
# logs_bucket_name        = "my-company-hls-logs-dev"

enable_versioning               = true
raw_bucket_lifecycle_days       = 30
processed_bucket_lifecycle_days = 90

# =============================================================================
# CloudFront CDN
# =============================================================================

cloudfront_price_class = "PriceClass_100"  # US, Canada, Europe

# Custom domain (optional - leave empty for CloudFront default domain)
custom_domain       = ""
acm_certificate_arn = ""

cors_allowed_origins = ["*"]

enable_origin_shield = true
origin_shield_region = "us-east-1"
enable_access_logs   = true

# Geo restrictions (optional)
geo_restriction_type      = "none"  # none, whitelist, blacklist
geo_restriction_locations = []

# =============================================================================
# Transcoding
# =============================================================================

enable_llhls = true
enable_cmaf  = true

segment_duration = 4
part_duration    = 0.5

transcode_presets = [
  "1920x1080:5000k:192k",
  "1280x720:2800k:128k",
  "854x480:1400k:128k",
  "640x360:800k:96k",
  "426x240:400k:64k"
]

# =============================================================================
# DRM (Optional)
# =============================================================================

enable_drm   = false
drm_provider = "local"  # local, buydrm, pallycon, axinom

# Only needed if enable_drm = true and drm_provider != "local"
# drm_key_server_url = "https://cpix.example.com/v1/keys"
# drm_api_key        = "your-api-key"  # Store in secrets manager

# widevine_license_url  = "https://license.example.com/widevine"
# fairplay_license_url  = "https://license.example.com/fairplay"
# playready_license_url = "https://license.example.com/playready"

# =============================================================================
# SSAI / MediaTailor (Optional)
# =============================================================================

enable_ssai = false

# Only needed if enable_ssai = true
# ad_decision_server_url            = "https://ads.example.com/vast"
# preroll_ad_server_url             = "https://ads.example.com/preroll"
# mediatailor_slate_ad_url          = "https://cdn.example.com/slate.mp4"
# mediatailor_personalization_threshold = 100
# mediatailor_max_duration          = 120

# =============================================================================
# Multi-CDN (Optional)
# =============================================================================

enable_multi_cdn = false

# Only needed if enable_multi_cdn = true
# cdn_providers = [
#   {
#     name       = "cloudfront"
#     base_url   = "https://dxxxxxx.cloudfront.net"
#     weight     = 70
#     priority   = 1
#     health_url = "https://dxxxxxx.cloudfront.net/health.txt"
#   },
#   {
#     name       = "fastly"
#     base_url   = "https://mycdn.fastly.net"
#     weight     = 30
#     priority   = 2
#     health_url = "https://mycdn.fastly.net/health.txt"
#   }
# ]
# cdn_failover_threshold    = 3
# cdn_health_check_interval = 30

# =============================================================================
# SQS Queue
# =============================================================================

sqs_queue_name        = "hls-processing-queue"
sqs_visibility_timeout = 900   # 15 minutes
sqs_message_retention = 1209600 # 14 days
sqs_dlq_max_receives  = 3

# =============================================================================
# DynamoDB (Optional - uncomment if using DynamoDB for metadata)
# =============================================================================

# dynamodb_table_name   = "hls-videos"
# dynamodb_billing_mode = "PAY_PER_REQUEST"

# =============================================================================
# Worker Configuration
# =============================================================================

worker_memory        = 2048  # MB
worker_cpu           = 1024
worker_timeout       = 900   # seconds
worker_desired_count = 1
worker_max_count     = 10

# =============================================================================
# API Configuration
# =============================================================================

api_rate_limit   = 100
api_burst_limit  = 200
jwt_secret       = "change-this-in-production"  # Store in secrets manager
jwt_expiration_hours = 24

# =============================================================================
# Monitoring
# =============================================================================

enable_xray        = true
log_retention_days = 30
alarm_email        = ""  # Set to receive CloudWatch alarm notifications
