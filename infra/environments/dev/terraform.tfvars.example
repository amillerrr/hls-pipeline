# HLS Pipeline - Terraform Variables
# Development Environment Configuration Example
# Copy to terraform.tfvars and customize values

# =============================================================================
# AWS Configuration
# =============================================================================

aws_region  = "us-west-2"
environment = "dev"

# =============================================================================
# Networking
# =============================================================================

vpc_id     = "vpc-xxxxxxxx"
subnet_ids = ["subnet-xxxxxxxx", "subnet-yyyyyyyy"]
assign_public_ip = true             # Set to false if using NAT Gateway

# =============================================================================
# Storage Configuration
# =============================================================================

raw_bucket_name       = "hls-pipeline-dev-raw"
processed_bucket_name = "hls-pipeline-dev-processed"
logs_bucket_name      = "hls-pipeline-dev-logs"
ads_bucket_name       = "hls-pipeline-dev-ads"

# S3 lifecycle rules
raw_bucket_expiration_days       = 7
processed_bucket_expiration_days = 90
cors_allowed_origins = ["*"]        # Restrict in production

# =============================================================================
# Transcoding Configuration
# =============================================================================

# LL-HLS Settings
enable_llhls      = true
enable_cmaf       = true
segment_duration  = 4
part_duration     = 0.5

# Use Shaka Packager for packaging (otherwise FFmpeg)
use_shaka_packager = false

# Presets configuration file path (relative to working directory)
# Leave empty to use default presets
presets_file = ""

# =============================================================================
# CDN Configuration
# =============================================================================

# Primary CDN (CloudFront)
cdn_enabled    = true
cdn_domain     = ""  # Will be auto-generated if empty
cdn_price_class = "PriceClass_100"  # US, Canada, Europe
cdn_certificate_arn = ""            # Leave empty for CloudFront default cert
cdn_geo_restriction_type = "none"   # or "whitelist", "blacklist"
cdn_geo_restriction_locations = []  # e.g., ["US", "CA", "GB"]


# Multi-CDN Configuration
enable_multi_cdn = false

# CDN Providers (when multi-CDN is enabled)
cdn_providers = [
  {
    name        = "cloudfront"
    base_url    = ""  # Auto-populated from CloudFront distribution
    weight      = 70
    priority    = 1
    health_url  = ""
    region      = "us-west-2"
  },
  {
    name        = "fastly"
    base_url    = "https://your-fastly-domain.global.ssl.fastly.net"
    weight      = 30
    priority    = 2
    health_url  = "https://your-fastly-domain.global.ssl.fastly.net/health"
    region      = "us-west-2"
  }
]

cdn_health_check_interval_seconds = 30
cdn_session_ttl_hours             = 2
cdn_strategy                      = "weighted"  # weighted, latency, geo, failover

# =============================================================================
# DRM Configuration
# =============================================================================

enable_drm = false

# DRM Provider: local, buydrm, pallycon, axinom
drm_provider = "local"

# Key Server Configuration (for external providers)
drm_key_server_url = ""
drm_api_key        = ""

# Widevine Configuration
widevine_license_url = ""

# FairPlay Configuration  
fairplay_license_url  = ""
fairplay_cert_url     = ""

# PlayReady Configuration
playready_license_url = ""

# Encryption scheme: cenc (AES-CTR) or cbcs (AES-CBC pattern)
encryption_scheme = "cbcs"  # cbcs recommended for HLS/FairPlay compatibility

# Key rotation period in hours (0 to disable)
key_rotation_period_hours = 0

# =============================================================================
# SSAI / Ad Insertion Configuration
# =============================================================================

enable_ssai = false

# MediaTailor Configuration
mediatailor_config_name = "hls-pipeline-dev"

# Ad Decision Server URL (VAST endpoint)
ad_decision_server_url = ""

# Slate Ad URL (played when no ads available)
slate_ad_url = ""

# Preroll Ad Server URL (optional)
preroll_ad_server_url = ""

# Personalization threshold in seconds
personalization_threshold_seconds = 3

# Maximum ad duration in seconds
max_ad_duration_seconds = 120

# SCTE-35 Settings
enable_scte35_passthrough = true
preserve_scte35_markers   = true

# =============================================================================
# ECS Configuration
# =============================================================================

# API Service
api_cpu                  = 512
api_memory               = 1024
api_desired_count        = 2
api_min_count            = 1
api_max_count            = 4
api_scale_in_cooldown    = 300
api_scale_out_cooldown   = 60

# Worker Service  
worker_cpu               = 2048
worker_memory            = 4096
worker_desired_count     = 2
worker_min_count         = 1
worker_max_count         = 10
worker_scale_in_cooldown = 300
worker_scale_out_cooldown = 60

# Container Images
api_image_tag    = "latest"
worker_image_tag = "latest"

# Max concurrent transcoding jobs per worker
max_concurrent_jobs = 2

# =============================================================================
# Queue Configuration
# =============================================================================

sqs_visibility_timeout_seconds = 900  # 15 min (should be > max job time)
sqs_message_retention_days       = 4
sqs_receive_wait_time_seconds    = 20    # Long polling
sqs_max_receive_count            = 3     # Before DLQ
sqs_alarm_threshold            = 100  # Queue depth alarm

# =============================================================================
# Database Configuration
# =============================================================================

dynamodb_billing_mode = "PAY_PER_REQUEST" # or "PROVISIONED"
dynamodb_ttl_enabled  = false

# Only used if billing_mode is PROVISIONED
dynamodb_read_capacity  = 5
dynamodb_write_capacity = 5

# =============================================================================
# API Configuration
# =============================================================================

# JWT secret for API authentication (min 32 characters in production)
jwt_secret = ""  # Set via environment variable JWT_SECRET

# Rate limiting
api_rate_limit_requests_per_second = 100
api_rate_limit_burst               = 200

# CORS
cors_allowed_origins = ["*"]  # Restrict in production

# Max upload size in bytes (10GB)
max_upload_size = 10737418240

# Presigned URL expiry in minutes
presign_expiry_minutes = 15

# =============================================================================
# Observability Configuration
# =============================================================================

enable_tracing = true
enable_metrics = true

# OpenTelemetry endpoint
otel_endpoint = ""  # Leave empty for local X-Ray

# Trace sample rate (0.0 - 1.0)
trace_sample_rate = 0.1

# CloudWatch Log retention in days
log_retention_days = 30

# =============================================================================
# Tags
# =============================================================================

tags = {
  Project     = "hls-pipeline"
  Environment = "dev"
  ManagedBy   = "terraform"
}

